#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  fnacc-flang [options] file...
  fnacc-flang -c [options] source.f90 [-o source.o]
  fnacc-flang [options] source.f90 objects... libraries... -o program

Compiler-driver behavior:
  * Ordinary Fortran sources are compiled by flang with user flags preserved.
  * Sources containing !$fnacc (also c$fnacc and *$fnacc) use the FNACC pipeline.
  * -c produces a normal relocatable object. An FNACC object includes its host
    code and embedded GPU image/JSON, so it can be linked later.
  * Without -c, sources are compiled to temporary objects and then linked with
    user objects, archives, libraries, and linker flags in command-line order.
  * -E, -S, and -fsyntax-only are passed directly to flang. They do not run the
    accelerator code-generation pipeline.

Traditional options:
  -c                       Compile, but do not link
  -o FILE                  Write object or executable to FILE
  -I DIR, -IDIR            Include/module search directory
  -J DIR, -JDIR            Fortran module output/search directory
  -L DIR, -LDIR            Library search directory
  -l LIB, -lLIB            Link library
  -D..., -U..., -O..., -g, -f..., -m..., -Wl,...
                           Passed through to the appropriate compiler/link step
  --                       Treat all remaining arguments as input files

FNACC options:
  --fnacc-force            Run FNACC lowering for every Fortran source
  --fnacc-disable          Never run FNACC lowering; delegate sources to flang
  --fnacc-runtime          Force FNACC runtime libraries into the link
  --fnacc-no-runtime       Do not auto-add FNACC runtime libraries
  --fnacc-target NAME      Accelerator platform: cuda (default) or hip
  --fnacc-gpu-arch ARCH    GPU architecture: e.g. sm_90a or gfx942
  --fnacc-sm NUM           CUDA SM compatibility spelling
  --fnacc-amd-arch ARCH    AMD architecture compatibility spelling
  --fnacc-backend NAME     Preferred code-generation backend; default auto
  --fnacc-fallback-backend NAME
                           Backend used when the preferred backend cannot lower
                           a kernel; default triton
  --fnacc-backend-fallback Enable backend fallback (the default)
  --fnacc-no-backend-fallback
                           Fail instead of using the fallback backend
  --fnacc-launch-abi N     Host launch ABI: 2 or 3 (default).
  --fnacc-num-warps N      Triton warps; default FNACC_NUM_WARPS or 1.
                           Multi-warp reduction lowering is automatic.
  --fnacc-threads-per-warp N
                           Threads per warp; CUDA currently requires 32
  --fnacc-num-stages N     Triton pipeline stages; default FNACC_NUM_STAGES or 3
  --fnacc-f64-matmul-strategy NAME
                           reduce, fma, or dot
  --fnacc-cuda-lib-dir DIR CUDA driver library directory
  --fnacc-cuda-libdevice FILE
                           CUDA libdevice bitcode; normally auto-detected
  --fnacc-rocm-path DIR    ROCm installation prefix; default ROCM_PATH or /opt/rocm
  --fnacc-rocm-device-lib-dir DIR
                           ROCm device bitcode directory; normally auto-detected
  --fnacc-hip-lib-dir DIR  HIP runtime library directory
  --fnacc-workdir DIR      Parent for a unique intermediate directory
  --fnacc-keep             Keep intermediate files
  --fnacc-verbose          Print commands before running them
  --fnacc-dry-run          Print commands without executing them
  --fnacc-stop-after STAGE Stop one FNACC source after a named internal stage
  --fnacc-backend NAME     Target a specific backend. Use "auto", "triton", or experimental "cuda-tile" 
  --fnacc-fallback-backend NAME 
                           Define a fall back backend. If none is specified Triton is the default
  --fnacc-no-backend-fallback
                           Turn off a default fallback so compilation fails if one isn't specified or available.
  -h, --help               Show this help

Compatibility aliases:
  --sm, --num-warps, --threads-per-warp, --num-stages,
  --f64-matmul-strategy, --cuda-lib-dir, --cuda-libdevice, --workdir, --keep,
  --verbose, --dry-run, and --stop-after are accepted as aliases.

Linking:
  Multiple FNACC sources, objects, and archives may contribute embedded kernel
  bundles to one executable. Auto-detection scans named objects and archives;
  use --fnacc-runtime when FNACC code is supplied only through -lNAME.

Environment:
  LLVM_BUILD               llvm-project build directory
  TRITON_OPT               path to triton-opt
  MLIR_TRANSLATE           path to mlir-translate
  LLC                      path to llc
  LD_LLD                   path to ld.lld (required for HIP/HSACO)
  LLVM_LINK                path to llvm-link; defaults to LLVM_BUILD/bin
  OPT                      path to opt; defaults to LLVM_BUILD/bin
  CUDA_LIB_DIR             Optional CUDA driver library directory

Optional environment:
  FNACC_LAUNCH_ABI         host launch ABI, defaults to 3
  FNACC_NUM_WARPS          number of warps to use, defaults to 1
  FNACC_THREADS_PER_WARP   threads per warp, defaults to 32
  FNACC_NUM_STAGES         number of Triton pipeline stages, defaults to 3
  FNACC_SM                 default CUDA SM, default 80
  FNACC_TARGET             cuda (default) or hip
  FNACC_GPU_ARCH           target architecture (sm_90a or gfx942)
  FNACC_AMD_GPU_ARCH       AMD architecture compatibility variable
  FNACC_CUDA_TILE_TRANSLATE CUDA Tile translator executable (default cuda-tile-translate)
  FNACC_TILEIRAS           Tile IR assembler executable (default tileiras)
  FNACC_BACKEND            preferred backend, defaults to auto
  FNACC_FALLBACK_BACKEND   fallback backend, defaults to triton
  FNACC_ALLOW_BACKEND_FALLBACK
                           boolean; defaults to true
  FNACC_CUDA_LIBDEVICE     CUDA libdevice.10.bc override. Required only when
                           generated device IR references __nv_* functions.
  ROCM_PATH                ROCm installation prefix; default /opt/rocm
  FNACC_ROCM_DEVICE_LIB_DIR
                           ROCm bitcode directory containing ocml.bc/ockl.bc
  FNACC_HIP_LIB_DIR        directory containing libamdhip64
  CUDA_HOME, CUDA_PATH, CUDAToolkit_ROOT
                           CUDA roots considered during libdevice discovery.
  FNACC_WORKDIR            default work directory. If unset, uses a temp dir.
  FNACC_CUDA_DEVICE        CUDA device ordinal; may be changed between calls.
  FNACC_USE_CURRENT_CONTEXT
                           use the caller's current CUDA context instead of a
                           retained primary context selected by device ordinal.
  FNACC_REDUCTION_STATS    print reduction workspace counters at process exit
  FLANG                    override flang-new
  FLANG_INTRINSIC_MODULES_PATH
                           override Flang's precompiled intrinsic module dir
  FIROPT                   override fir-opt
  TCO                      override tco
  CLANG                    override clang

Advanced environment:
  FNACC_TTGIR_TO_LLVM_PASSES
                           Override TTGIR -> LLVM MLIR pass pipeline.
                           Parsed with shell-like quoting.
  FNACC_TTIR_TO_TTGIR_PASSES
                           Override TTIR -> TTGIR pass pipeline.
                           Parsed with shell-like quoting.
  FNACC_HIP_TTIR_TO_TTGIR_PASSES
  FNACC_HIP_TTGIR_TO_LLVM_PASSES
                           HIP-specific pass-pipeline overrides.
  FNACC_ALLOW_EMPTY_KERNELS
                           Allow no recognized kernels even when an FNACC
                           parallel launch was present. Data-only FNACC
                           sources are accepted automatically.
                           Default: 0
EOF
}

die() {
  echo "fnacc-flang: error: $*" >&2
  exit 1
}

warn() {
  echo "fnacc-flang: warning: $*" >&2
}

log() {
  echo "[fnacc-flang] $*" >&2
}

quote_cmd() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
}

run() {
  if [[ "$VERBOSE" == "1" || "$DRY_RUN" == "1" ]]; then
    quote_cmd "$@"
  fi
  if [[ "$DRY_RUN" != "1" ]]; then
    "$@"
  fi
}

require_file() {
  [[ -f "$1" ]] || die "file not found: $1"
}

require_exe() {
  [[ -x "$1" ]] || die "executable not found or not executable: $1"
}

normalize_bool() {
  case "${1,,}" in
    1|true|yes|on) printf '%s\n' true ;;
    0|false|no|off) printf '%s\n' false ;;
    *) die "invalid boolean '$1'; expected true/false, yes/no, on/off, or 1/0" ;;
  esac
}

abspath() {
  python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$1"
}

hash_path() {
  python3 -c 'import hashlib,os,sys; print(hashlib.sha1(os.path.abspath(sys.argv[1]).encode()).hexdigest()[:8])' "$1"
}

make_temp_file() {
  mktemp "$WORKDIR/.fnacc-check.XXXXXX"
}

object_for_src() {
  local src="$1"
  local stem hash
  stem="$(basename "$src")"
  stem="${stem%.*}"
  hash="$(hash_path "$src")"
  echo "$OBJ_DIR/${stem}_${hash}.o"
}

maybe_stop() {
  local stage="$1"
  if [[ "$STOP_AFTER" == "$stage" ]]; then
    log "stopping after stage: $stage"
    log "workdir kept: $WORKDIR"
    exit 0
  fi
}

generate_embedded_bundle_c() {
  local manifest="$1"
  local json_file="$2"
  local out_c="$3"

  python3 - "$manifest" "$json_file" "$out_c" <<'PY'
import json
import re
import sys
from pathlib import Path

manifest_path = Path(sys.argv[1])
json_path = Path(sys.argv[2])
out_path = Path(sys.argv[3])

rows = json.loads(manifest_path.read_text(encoding="utf-8"))
json_bytes = json_path.read_bytes()
metadata = json.loads(json_bytes.decode("utf-8"))

def c_ident(s):
    return re.sub(r'[^A-Za-z0-9_]', '_', s)

def emit_array(name, data):
    lines = []
    lines.append(f"static const unsigned char {name}[] __attribute__((aligned(16))) = {{")
    for i in range(0, len(data), 12):
        chunk = data[i:i + 12]
        lines.append("  " + ", ".join(f"0x{b:02x}" for b in chunk) + ",")
    lines.append("};")
    return "\n".join(lines)

chunks = []
image_array_names = []
image_kinds = []

kind_values = {"ptx": 1, "cubin": 2, "hsaco": 3}
kernels_by_name = {
    str(kernel.get("name")): kernel for kernel in metadata.get("kernels", [])
}

for row in rows:
    name = c_ident(row["name"])
    kernel = kernels_by_name.get(str(row["name"]), {})
    image_kind = str(
        kernel.get(
            "device_image_kind", metadata.get("device_image_kind", "ptx")
        )
    )
    if image_kind not in kind_values:
        raise SystemExit(
            f"fnacc-flang: error: cannot embed unsupported image kind {image_kind!r}"
        )
    image_path = row.get("image", row.get("ptx"))
    if not image_path:
        raise SystemExit(
            f"fnacc-flang: error: manifest has no device image for {row['name']}"
        )
    arr = f"__fnacc_embedded_image_{row['index']}_{name}"
    image_array_names.append(arr)
    image_kinds.append(kind_values[image_kind])
    chunks.append(emit_array(arr, Path(image_path).read_bytes()))

chunks.append(emit_array("__fnacc_embedded_json", json_bytes))

ptrs = ",\n  ".join(f"(const void *){name}" for name in image_array_names)
sizes = ",\n  ".join(f"sizeof({name})" for name in image_array_names)
kinds = ",\n  ".join(str(kind) for kind in image_kinds)

content = f"""\
#include <stddef.h>
#include <stdint.h>

extern void __fnacc_register_embedded_device_bundle(
    const void * const *imageData,
    const size_t *imageSizes,
    const int32_t *imageKinds,
    size_t imageCount,
    const char *jsonData,
    size_t jsonSize);

{chr(10).join(chunks)}

static const void *__fnacc_embedded_image_ptrs[] = {{
  {ptrs}
}};

static const size_t __fnacc_embedded_image_sizes[] = {{
  {sizes}
}};

static const int32_t __fnacc_embedded_image_kinds[] = {{
  {kinds}
}};

__attribute__((constructor))
static void __fnacc_register_embedded_payload(void) {{
  __fnacc_register_embedded_device_bundle(
      __fnacc_embedded_image_ptrs,
      __fnacc_embedded_image_sizes,
      __fnacc_embedded_image_kinds,
      sizeof(__fnacc_embedded_image_ptrs) / sizeof(__fnacc_embedded_image_ptrs[0]),
      (const char *)__fnacc_embedded_json,
      sizeof(__fnacc_embedded_json));
}}
"""

out_path.write_text(content, encoding="utf-8")
PY
}

validate_ptx_kernel_abi() {
  local manifest="$1"
  local json_file="$2"

  python3 - "$manifest" "$json_file" <<'PY'
import json
import re
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
metadata = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
kernels = metadata.get("kernels", [])

if len(manifest) != len(kernels):
    raise SystemExit(
        f"fnacc-flang: error: manifest has {len(manifest)} kernels but JSON has {len(kernels)}"
    )

by_name = {str(k.get("name")): k for k in kernels}
for row in manifest:
    if row.get("backend") == "cuda-tile":
        continue
    name = str(row["name"])
    kernel = by_name.get(name)
    if kernel is None:
        raise SystemExit(f"fnacc-flang: error: no JSON metadata for PTX kernel {name}")

    text = Path(row["ptx"]).read_text(encoding="utf-8")
    # Match the entry declaration itself, not the start of its body.  LLVM's
    # NVPTX backend may place directives such as `.maxntid` between the closing
    # parameter parenthesis and `{`, so requiring `) {` rejects valid PTX.
    # Anchoring at the beginning of a line prevents matches in comments while
    # still accepting the PTX linkage qualifiers used for kernel entries.
    match = re.search(
        r"^[ \t]*(?:\.(?:visible|extern|weak)[ \t]+)*\.entry[ \t]+"
        + re.escape(name)
        + r"[ \t]*\((.*?)\)",
        text,
        flags=re.MULTILINE | re.DOTALL,
    )
    if match is None:
        raise SystemExit(f"fnacc-flang: error: PTX entry {name} was not found in {row['ptx']}")

    actual = len(re.findall(r"\.param\b", match.group(1)))
    explicit = len(kernel.get("params", []))
    expected_hidden = int(
        kernel.get(
            "private_pointer_args", kernel.get("triton_hidden_ptr_args", 2)
        )
    )
    actual_hidden = actual - explicit
    if actual_hidden != expected_hidden:
        raise SystemExit(
            "fnacc-flang: error: Triton/runtime ABI mismatch for "
            f"{name}: PTX has {actual} parameters ({actual_hidden} hidden), "
            f"but metadata expects {explicit} explicit + {expected_hidden} hidden. "
            "Use matching LLVM/Triton sources; do not run this binary."
        )
PY
}

write_toolchain_manifest() {
  local output="$1"
  {
    printf 'generated_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    local tool path
    for tool in FLANG FIROPT TCO CLANG TRITON_OPT MLIR_TRANSLATE LLVM_LINK OPT LLC LD_LLD; do
      path="${!tool}"
      printf '%s=%q\n' "$tool" "$path"
      printf '%s_VERSION=' "$tool"
      if [[ -n "$path" && -x "$path" ]]; then
        "$path" --version 2>&1 | head -1 || true
      else
        printf '<not configured>\n'
      fi
    done
    printf 'ACCELERATOR_TARGET=%s\nGPU_ARCH=%s\nSM=%s\nNUM_WARPS=%s\nTHREADS_PER_WARP=%s\nNUM_STAGES=%s\n' \
      "$ACCELERATOR_TARGET" "$GPU_ARCH" "$SM" "$NUM_WARPS" \
      "$THREADS_PER_WARP" "$NUM_STAGES"
    printf 'LAUNCH_ABI=%s\n' "$LAUNCH_ABI"
    printf 'BACKEND_REQUESTED=%s\nBACKEND_FALLBACK=%s\nALLOW_BACKEND_FALLBACK=%s\n' \
      "$BACKEND" "$FALLBACK_BACKEND" \
      "$ALLOW_BACKEND_FALLBACK"
    printf 'CUDA_LIBDEVICE=%q\n' "$CUDA_LIBDEVICE"
    printf 'ROCM_PATH=%q\nROCM_DEVICE_LIB_DIR=%q\nHIP_LIB_DIR=%q\n' \
      "$ROCM_PATH" "$ROCM_DEVICE_LIB_DIR" "$HIP_LIB_DIR"
  } > "$output"
}

validate_json() {
  local json_file="$1"
  python3 -m json.tool "$json_file" >/dev/null || die "invalid JSON: $json_file"
}

validate_kernel_json() {
  local json_file="$1"

  python3 - "$json_file" "$ACCELERATOR_TARGET" "${SM_NUM:-0}" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])
if data.get("fnacc_schema_version") != 1:
    print(f"fnacc-flang: error: unsupported FNACC JSON schema in {path}", file=sys.stderr)
    raise SystemExit(1)
contract_version = data.get("backend_contract_version")
if contract_version is not None and int(contract_version) != 1:
    print(
        f"fnacc-flang: error: unsupported backend contract version {contract_version}",
        file=sys.stderr,
    )
    raise SystemExit(1)
if not isinstance(kernels, list):
    print("fnacc-flang: error: kernel JSON has no kernel list", file=sys.stderr)
    raise SystemExit(1)

for kernel in kernels:
    precision = kernel.get("matmul_precision", "ieee")
    if precision not in ("ieee", "tf32", "tf32x3"):
        raise SystemExit("fnacc-flang: error: invalid matmul_precision metadata")
    if precision != "ieee":
        if sys.argv[2] != "cuda" or int(sys.argv[3]) < 80:
            raise SystemExit(
                f"fnacc-flang: error: matmul_precision({precision}) requires CUDA SM80 or newer"
            )
    if not isinstance(kernel.get("params"), list):
        print("fnacc-flang: error: kernel JSON has no parameter list", file=sys.stderr)
        raise SystemExit(1)
    private_args = int(
        kernel.get(
            "private_pointer_args", kernel.get("triton_hidden_ptr_args", -1)
        )
    )
    if private_args != (0 if kernel.get("backend") == "cuda-tile" else 2):
        print(
            "fnacc-flang: error: private pointer count disagrees with backend",
            file=sys.stderr,
        )
        raise SystemExit(1)
PY
}

kernel_json_count() {
  local json_file="$1"

  python3 - "$json_file" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])
if not isinstance(kernels, list):
    raise SystemExit("fnacc-flang: error: kernel JSON has no kernel list")
print(len(kernels))
PY
}

read_backend_contract() {
  local json_file="$1"

  python3 - "$json_file" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])

def first_kernel_value(key, default):
    if not kernels:
        return default
    return kernels[0].get(key, default)

selected = str(data.get("selected_backend", first_kernel_value("backend", "triton")))
device_ir = str(data.get("device_ir_kind", first_kernel_value("device_ir_kind", "ttir")))
image_kind = str(
    data.get("device_image_kind", first_kernel_value("device_image_kind", "ptx"))
)
accelerator_target = str(
    data.get(
        "accelerator_target",
        first_kernel_value("accelerator_target", "cuda"),
    )
)
used_fallback = bool(data.get("used_backend_fallback", False))

for kernel in kernels:
    contract = (kernel.get("backend", "triton"), kernel.get("device_ir_kind", "ttir"),
                kernel.get("device_image_kind", "ptx"))
    if contract not in (("triton", "ttir", "ptx"), ("triton", "ttir", "hsaco"),
                        ("cuda-tile", "cuda-tile-ir", "cubin")):
        raise SystemExit(f"fnacc-flang: error: unsupported backend contract {contract}")
    if kernel.get("accelerator_target", accelerator_target) != accelerator_target:
        raise SystemExit("fnacc-flang: error: mixed accelerator targets")
if len({k.get("backend", "triton") for k in kernels}) > 1:
    selected, device_ir, image_kind = "mixed", "mixed", "mixed"

print("\t".join((selected, device_ir, image_kind, accelerator_target,
                 "true" if used_fallback else "false")))
PY
}


kernel_matmul_precision() {
  python3 - "$1" "$2" <<'PYCODE'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as stream:
    kernels = json.load(stream)["kernels"]
for kernel in kernels:
    if kernel["name"] == sys.argv[2]:
        print(kernel.get("matmul_precision", "ieee"))
        break
else:
    raise SystemExit("fnacc-flang: error: missing kernel precision metadata")
PYCODE
}

require_triton_toolchain() {
  [[ -n "$TRITON_OPT" ]] || die "TRITON_OPT is required by the selected Triton backend"
  [[ -n "$MLIR_TRANSLATE" ]] || die "MLIR_TRANSLATE is required by the selected Triton backend"
  [[ -n "$LLC" ]] || die "LLC is required by the selected Triton backend"
  require_exe "$TRITON_OPT"
  require_exe "$MLIR_TRANSLATE"
  require_exe "$LLC"
}

llvm_ir_requires_cuda_libdevice() {
  local input="$1"

  python3 - "$input" <<'PY'
import re
import sys

text = open(sys.argv[1], "r", encoding="utf-8").read()
pattern = r'(?m)^\s*declare\b[^\n]*@(?:"?__nv_[A-Za-z0-9_.$]+"?)\s*\('
raise SystemExit(0 if re.search(pattern, text) else 1)
PY
}

resolve_cuda_libdevice() {
  if [[ -n "$CUDA_LIBDEVICE" ]]; then
    [[ -f "$CUDA_LIBDEVICE" ]] ||
      die "CUDA libdevice bitcode does not exist: $CUDA_LIBDEVICE"
    return
  fi

  local root candidate ptxas_path clang_resource
  local -a roots=()

  for root in "${CUDA_HOME:-}" "${CUDA_PATH:-}" \
              "${CUDAToolkit_ROOT:-}" "${CUDA_ROOT:-}"; do
    [[ -n "$root" ]] && roots+=("$root")
  done

  if [[ -n "$CUDA_LIB_DIR" ]]; then
    roots+=("$(dirname "$CUDA_LIB_DIR")")
  fi

  ptxas_path="$(command -v ptxas 2>/dev/null || true)"
  if [[ -n "$ptxas_path" ]]; then
    ptxas_path="$(readlink -f "$ptxas_path" 2>/dev/null || printf '%s' "$ptxas_path")"
    roots+=("$(dirname "$(dirname "$ptxas_path")")")
  fi

  clang_resource="$("$CLANG" --print-resource-dir 2>/dev/null || true)"
  roots+=("/usr/local/cuda")

  for root in "${roots[@]}"; do
    for candidate in \
      "$root/nvvm/libdevice/libdevice.10.bc" \
      "$root/lib/nvvm/libdevice/libdevice.10.bc" \
      "$root/libdevice/libdevice.10.bc"; do
      if [[ -f "$candidate" ]]; then
        CUDA_LIBDEVICE="$candidate"
        return
      fi
    done
  done

  if [[ -n "$clang_resource" ]]; then
    for candidate in \
      "$clang_resource/lib/nvptx64-nvidia-cuda/libdevice.10.bc" \
      "$clang_resource/lib/libdevice.10.bc"; do
      if [[ -f "$candidate" ]]; then
        CUDA_LIBDEVICE="$candidate"
        return
      fi
    done
  fi

  candidate="/usr/lib/nvidia-cuda-toolkit/libdevice/libdevice.10.bc"
  if [[ -f "$candidate" ]]; then
    CUDA_LIBDEVICE="$candidate"
    return
  fi

  die "generated CUDA device IR references __nv_* functions, but libdevice.10.bc was not found; set FNACC_CUDA_LIBDEVICE or pass --fnacc-cuda-libdevice"
}

link_cuda_libdevice_if_needed() {
  local input="$1"
  local linked_output="$2"
  local optimized_output="$3"
  local kernel_name="$4"

  if ! llvm_ir_requires_cuda_libdevice "$input"; then
    return 1
  fi

  resolve_cuda_libdevice
  require_exe "$LLVM_LINK"
  require_exe "$OPT"
  log "  link CUDA libdevice for $kernel_name"
  run "$LLVM_LINK" --only-needed "$input" "$CUDA_LIBDEVICE" \
    -o "$linked_output"
  test -s "$linked_output" ||
    die "libdevice-linked LLVM IR was not generated for $kernel_name"

  # CUDA libdevice contains available_externally definitions.  Linking makes
  # those definitions visible, but they are not emitted as standalone PTX
  # functions.  Run the normal LLVM optimization pipeline so required
  # definitions are internalized/inlined before llc.  Without this step llc
  # can leave calls such as __nv_sqrt as unresolved PTX externs.
  log "  optimize CUDA libdevice for $kernel_name"
  run "$OPT" "-passes=default<O3>" "$linked_output" \
    -o "$optimized_output"
  test -s "$optimized_output" ||
    die "libdevice-optimized LLVM IR was not generated for $kernel_name"
  return 0
}

validate_no_unresolved_cuda_libdevice_functions() {
  local ptx="$1"
  local kernel_name="$2"

  python3 - "$ptx" "$kernel_name" <<'PY'
import re
import sys

path, kernel = sys.argv[1:3]
text = open(path, "r", encoding="utf-8").read()
names = set()
for start in re.finditer(r'(?m)^[ \t]*\.extern[ \t]+\.func\b', text):
    # PTX extern function declarations can span several lines.  The first
    # semicolon after `.extern .func` terminates the declaration.
    end = text.find(';', start.start())
    declaration = text[start.start():end + 1 if end >= 0 else len(text)]
    match = re.search(r'\b(__nv[A-Za-z0-9_.$]+)\b', declaration)
    if match:
        names.add(match.group(1))
names = sorted(names)
if names:
    print(
        "fnacc-flang: error: PTX for "
        + kernel
        + " still contains unresolved CUDA libdevice functions: "
        + ", ".join(names),
        file=sys.stderr,
    )
    print(
        "fnacc-flang: error: use LLVM_LINK, OPT, LLC, and libdevice.10.bc from compatible toolchains",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

llvm_ir_requires_rocm_device_libs() {
  local input="$1"
  grep -Eq '@(__ocml_|__ockl_)' "$input"
}

resolve_rocm_device_libs() {
  if [[ -z "$ROCM_DEVICE_LIB_DIR" ]]; then
    local candidate
    for candidate in \
      "$ROCM_PATH/amdgcn/bitcode" \
      "$ROCM_PATH/lib/llvm/amdgcn/bitcode" \
      "$ROCM_PATH/lib/bitcode"; do
      if [[ -f "$candidate/ocml.bc" && -f "$candidate/ockl.bc" ]]; then
        ROCM_DEVICE_LIB_DIR="$candidate"
        break
      fi
    done
  fi

  [[ -n "$ROCM_DEVICE_LIB_DIR" && -d "$ROCM_DEVICE_LIB_DIR" ]] ||
    die "ROCm device libraries were not found; set FNACC_ROCM_DEVICE_LIB_DIR or --fnacc-rocm-device-lib-dir"
  [[ -f "$ROCM_DEVICE_LIB_DIR/ocml.bc" ]] ||
    die "ROCm device library is missing: $ROCM_DEVICE_LIB_DIR/ocml.bc"
  [[ -f "$ROCM_DEVICE_LIB_DIR/ockl.bc" ]] ||
    die "ROCm device library is missing: $ROCM_DEVICE_LIB_DIR/ockl.bc"
}

collect_rocm_device_libs() {
  resolve_rocm_device_libs

  local wave isa candidate
  if (( THREADS_PER_WARP == 64 )); then
    wave="oclc_wavefrontsize64_on.bc"
  else
    wave="oclc_wavefrontsize64_off.bc"
  fi
  isa="oclc_isa_version_${GPU_ARCH#gfx}.amdgcn.bc"

  ROCM_DEVICE_LIBS=(
    "$ROCM_DEVICE_LIB_DIR/ocml.bc"
    "$ROCM_DEVICE_LIB_DIR/ockl.bc"
  )
  for candidate in \
    "$ROCM_DEVICE_LIB_DIR/oclc_daz_opt_off.bc" \
    "$ROCM_DEVICE_LIB_DIR/oclc_unsafe_math_off.bc" \
    "$ROCM_DEVICE_LIB_DIR/oclc_finite_only_off.bc" \
    "$ROCM_DEVICE_LIB_DIR/oclc_correctly_rounded_sqrt_on.bc" \
    "$ROCM_DEVICE_LIB_DIR/$wave" \
    "$ROCM_DEVICE_LIB_DIR/$isa"; do
    [[ -f "$candidate" ]] && ROCM_DEVICE_LIBS+=("$candidate")
  done

  # ROCm releases use versioned ABI control bitcode. Select the newest
  # installed spelling deterministically.
  candidate="$(find "$ROCM_DEVICE_LIB_DIR" -maxdepth 1 -type f \
    -name 'oclc_abi_version_*.bc' -print 2>/dev/null | sort -V | tail -1)"
  [[ -z "$candidate" ]] || ROCM_DEVICE_LIBS+=("$candidate")

  [[ -f "$ROCM_DEVICE_LIB_DIR/$wave" ]] ||
    die "ROCm device libraries do not provide $wave"
  [[ -f "$ROCM_DEVICE_LIB_DIR/$isa" ]] ||
    die "ROCm device libraries do not support $GPU_ARCH (missing $isa)"
}

link_rocm_device_libs_if_needed() {
  local input="$1"
  local linked_output="$2"
  local optimized_output="$3"
  local kernel_name="$4"

  if ! llvm_ir_requires_rocm_device_libs "$input"; then
    return 1
  fi

  collect_rocm_device_libs
  require_exe "$LLVM_LINK"
  require_exe "$OPT"
  log "  link ROCm device libraries for $kernel_name"
  run "$LLVM_LINK" --only-needed "$input" "${ROCM_DEVICE_LIBS[@]}" \
    -o "$linked_output"
  test -s "$linked_output" ||
    die "ROCm-device-library-linked LLVM IR was not generated for $kernel_name"

  run "$OPT" "-passes=default<O3>" "$linked_output" -o "$optimized_output"
  test -s "$optimized_output" ||
    die "ROCm-device-library-optimized LLVM IR was not generated for $kernel_name"
  return 0
}

validate_hsaco() {
  local image="$1"
  local kernel_name="$2"
  test -s "$image" || die "HSACO was not generated for $kernel_name"
  # ELF magic is a cheap, toolchain-independent guard against embedding an
  # assembler diagnostic or textual IR under an .hsaco suffix.
  python3 - "$image" "$kernel_name" <<'PY'
import sys
path, kernel = sys.argv[1:3]
with open(path, "rb") as f:
    magic = f.read(4)
if magic != b"\x7fELF":
    raise SystemExit(
        f"fnacc-flang: error: device image for {kernel} is not an ELF HSACO"
    )
PY
}

validate_no_triton_gpu_ops() {
  local file="$1"

  local ttg_left
  local tt_left

  ttg_left="$(make_temp_file)"
  tt_left="$(make_temp_file)"

  grep -nE '^[[:space:]]*((%[A-Za-z0-9_.$#-]+[[:space:]]*=[[:space:]]*)?)("?ttg\.)' \
    "$file" > "$ttg_left" || true

  if [[ -s "$ttg_left" ]]; then
    echo "fnacc-flang: error: residual TritonGPU dialect ops remain after LLVM lowering:" >&2
    head -20 "$ttg_left" >&2
    echo >&2
    echo "This usually means the Triton pass pipeline did not fully lower TTGIR." >&2
    echo "Check that triton-opt provides --convert-nv-gpu-to-llvm, or set FNACC_TTGIR_TO_LLVM_PASSES." >&2
    echo "The driver already lowers residual ttg.warp_id operations; this is another unlowered TritonGPU operation." >&2
    rm -f "$ttg_left" "$tt_left"
    exit 1
  fi

  grep -nE '^[[:space:]]*((%[A-Za-z0-9_.$#-]+[[:space:]]*=[[:space:]]*)?)("?tt\.)' \
    "$file" > "$tt_left" || true

  if [[ -s "$tt_left" ]]; then
    echo "fnacc-flang: error: residual Triton dialect ops remain after LLVM lowering:" >&2
    head -20 "$tt_left" >&2
    rm -f "$ttg_left" "$tt_left"
    exit 1
  fi

  rm -f "$ttg_left" "$tt_left"
}

validate_no_unrealized_casts() {
  local file="$1"
  local left

  left="$(make_temp_file)"

  grep -nE 'builtin\.unrealized_conversion_cast|"builtin\.unrealized_conversion_cast"' \
    "$file" > "$left" || true

  if [[ -s "$left" ]]; then
    echo "fnacc-flang: error: unrealized conversion casts remain before LLVM translation:" >&2
    head -20 "$left" >&2
    rm -f "$left"
    exit 1
  fi

  rm -f "$left"
}

lower_ttg_warp_id_to_nvvm() {
  local file="$1"
  local tmp
  tmp="$(make_temp_file)"

  python3 - "$file" "$tmp" <<'PY'
import re
import sys

inp = sys.argv[1]
out = sys.argv[2]

pat = re.compile(
    r'^(\s*)(%[A-Za-z0-9_.$#-]+)\s*=\s*ttg\.warp_id'
    r'(?:\s*\{[^}]*\})?'
    r'(?:\s*:\s*i32)?\s*$'
)

changed = 0

with open(inp, "r", encoding="utf-8") as f, open(out, "w", encoding="utf-8") as g:
    for line in f:
        text = line.rstrip("\n")
        m = pat.match(text)
        if not m:
            g.write(line)
            continue

        indent, name = m.groups()
        g.write(
            f'{indent}{name} = llvm.inline_asm has_side_effects '
            f'asm_dialect = att "mov.u32 $0, %warpid;", "=r" '
            f': () -> i32\n'
        )
        changed += 1

if changed:
    print(
        f"fnacc-flang: lowered {changed} ttg.warp_id op(s) "
        f"to the NVPTX warp-id register",
        file=sys.stderr,
    )
PY

  mv "$tmp" "$file"
}

split_pass_pipeline() {
  local text="$1"
  python3 - "$text" <<'PY'
import shlex
import sys

for item in shlex.split(sys.argv[1]):
    print(item)
PY
}

split_ttir_per_kernel() {
  local ttir_file="$1"
  local json_file="$2"
  local out_dir="$3"
  local manifest="$4"

  mkdir -p "$out_dir"

  python3 - "$ttir_file" "$json_file" "$out_dir" "$manifest" <<'PY'
import json
import re
import sys
from pathlib import Path

ttir_path = Path(sys.argv[1])
json_path = Path(sys.argv[2])
out_dir = Path(sys.argv[3])
manifest_path = Path(sys.argv[4])

ttir = ttir_path.read_text(encoding="utf-8")

with json_path.open("r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])

def find_matching_brace(text, open_pos):
    depth = 0
    in_str = False
    escaped = False

    for i in range(open_pos, len(text)):
        c = text[i]

        if escaped:
            escaped = False
            continue

        if c == "\\" and in_str:
            escaped = True
            continue

        if c == '"':
            in_str = not in_str
            continue

        if in_str:
            continue

        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i + 1

    raise RuntimeError("unmatched brace")

def extract_tt_func(text, name, tile=False):
    marker = f"entry @{name}(" if tile else f"tt.func @{name}("
    pos = text.find(marker)
    if pos < 0:
        raise RuntimeError(f"could not find TTIR function @{name}")

    line_start = text.rfind("\n", 0, pos) + 1

    sig_end = text.find("\n", pos)
    if sig_end < 0:
        raise RuntimeError(f"malformed one-line signature for @{name}")

    sig_line = text[pos:sig_end]

    # Current FNACC emits:
    #   tt.func @foo(...) attributes {noinline = false} {
    # The body opener is the last "{" on the signature line.
    rel_body_open = sig_line.rfind("{")
    if rel_body_open < 0:
        raise RuntimeError(f"could not find body opener for @{name}")

    body_open = pos + rel_body_open
    func_end = find_matching_brace(text, body_open)

    return text[line_start:func_end].rstrip() + "\n"

rows = []
seen_names = set()
seen_ids = set()

for idx, k in enumerate(kernels):
    name = str(k["name"])
    kernel_id = int(k["id"])
    num_warps = int(k.get("num_warps", 1))
    threads_per_warp = int(k.get("threads_per_warp", 32))
    num_ctas = int(k.get("num_ctas", 1))
    num_stages = int(k.get("num_stages", 3))

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        raise RuntimeError(f"unsafe or invalid kernel name: {name!r}")
    if name in seen_names or kernel_id in seen_ids:
        raise RuntimeError(f"duplicate kernel name or id: {name!r}, {kernel_id}")
    if kernel_id < 0 or num_warps <= 0 or threads_per_warp not in (32, 64):
        raise RuntimeError(f"invalid launch metadata for kernel {name}")
    if num_ctas <= 0 or num_stages <= 0:
        raise RuntimeError(f"invalid Triton metadata for kernel {name}")
    seen_names.add(name)
    seen_ids.add(kernel_id)

    is_tile = k.get("backend") == "cuda-tile"
    source_text = Path(sys.argv[1] + ".cuda-tile").read_text() if is_tile else ttir
    func_text = extract_tt_func(source_text, name, is_tile)

    module_text = (
        'module attributes {'
        f'"ttg.num-warps" = {num_warps} : i32, '
        f'"ttg.num-ctas" = {num_ctas} : i32, '
        f'"ttg.num-stages" = {num_stages} : i32, '
        f'"ttg.threads-per-warp" = {threads_per_warp} : i32'
        '} {\n'
        f'{func_text}'
        '}\n'
    )

    if is_tile:
        module_text = "cuda_tile.module @fnacc_tiles {\n" + func_text + "}\n"
    out_ttir = out_dir / (f"{name}.cuda-tile.mlir" if is_tile else f"{name}.ttir")
    out_ttir.write_text(module_text, encoding="utf-8")

    image_kind = str(
        k.get("device_image_kind", data.get("device_image_kind", "ptx"))
    )
    extension = {"ptx": ".ptx", "cubin": ".cubin", "hsaco": ".hsaco"}.get(
        image_kind
    )
    if extension is None:
        raise RuntimeError(f"unsupported device image kind: {image_kind!r}")
    image_path = out_dir / f"{name}{extension}"

    rows.append({
        "index": idx,
        "id": kernel_id,
        "name": name,
        "backend": str(k.get("backend", data.get("selected_backend", "triton"))),
        "device_ir_kind": str(k.get("device_ir_kind", data.get("device_ir_kind", "ttir"))),
        "device_image_kind": image_kind,
        "num_warps": num_warps,
        "threads_per_warp": threads_per_warp,
        "ttir": str(out_ttir),
        "ttgir": str(out_dir / f"{name}.ttgir.mlir"),
        "llvm_mlir": str(out_dir / f"{name}.llvm.mlir"),
        "ll": str(out_dir / f"{name}.ll"),
        "ptx": str(out_dir / f"{name}.ptx"),
        "object": str(out_dir / f"{name}.amdgpu.o"),
        "hsaco": str(out_dir / f"{name}.hsaco"),
        "image": str(image_path),
    })

manifest_path.write_text(json.dumps(rows, indent=2), encoding="utf-8")
PY
}

manifest_count() {
  python3 - "$1" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    print(len(json.load(f)))
PY
}

manifest_get() {
  local manifest="$1"
  local index="$2"
  local key="$3"

  python3 - "$manifest" "$index" "$key" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    rows = json.load(f)
print(rows[int(sys.argv[2])][sys.argv[3]])
PY
}

read_effective_num_warps_from_json() {
  local json_file="$1"
  local fallback="$2"

  python3 - "$json_file" "$fallback" <<'PY'
import json
import sys

path = sys.argv[1]
fallback = int(sys.argv[2])

with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])
if not kernels:
    print(fallback)
    raise SystemExit(0)

warps = []
for k in kernels:
    try:
        warps.append(int(k.get("num_warps", fallback)))
    except Exception:
        warps.append(fallback)

print(max(warps) if warps else fallback)
PY
}

is_fortran_source() {
  local lower="${1,,}"
  case "$lower" in
    *.f|*.for|*.ftn|*.f77|*.f90|*.f95|*.f03|*.f08|*.f18|*.f23)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_fortran_language() {
  case "${1,,}" in
    f77|f90|f95|f03|f08|f18|f23|fortran|fortran-free-form|fortran-fixed-form)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

source_has_fnacc() {
  local source="$1"
  [[ "$source" != "-" ]] || return 1
  grep -Eiq '^[[:space:]]*([!c*][[:space:]]*)?\$fnacc([[:space:]]|$)' "$source"
}

source_has_fnacc_parallel() {
  local source="$1"
  [[ "$source" != "-" ]] || return 1
  grep -Eiq '^[[:space:]]*([!c*][[:space:]]*)?\$fnacc[[:space:]]+parallel([[:space:]]|$)' "$source"
}

fir_has_fnacc_launch() {
  local fir_file="$1"
  grep -Eq '(^|[[:space:]"(])fnacc\.launch([[:space:]"({]|$)' "$fir_file"
}

sanitize_stem() {
  local stem
  stem="$(basename "$1")"
  stem="${stem%.*}"
  stem="${stem//[^A-Za-z0-9._-]/_}"
  [[ -n "$stem" ]] || stem="source"
  printf '%s\n' "$stem"
}

resolve_flang() {
  LLVM_BUILD="${LLVM_BUILD:-}"
  if [[ -z "${FLANG:-}" && -n "$LLVM_BUILD" ]]; then
    if [[ -x "$LLVM_BUILD/bin/flang-new" ]]; then
      FLANG="$LLVM_BUILD/bin/flang-new"
    elif [[ -x "$LLVM_BUILD/bin/flang" ]]; then
      FLANG="$LLVM_BUILD/bin/flang"
    fi
  fi
  if [[ -z "${FLANG:-}" ]]; then
    FLANG="$(command -v flang-new || command -v flang || true)"
  fi
  [[ -n "${FLANG:-}" ]] || die "FLANG is not set and flang-new/flang was not found in PATH"
  require_exe "$FLANG"
}

resolve_flang_intrinsic_modules() {
  local -a compiler_flags=("$@")
  local -a module_dirs=()
  local resource_dir=""
  local target=""
  local intrinsic_dir=""
  local flag module_file
  local i

  # An explicit compiler option has precedence over wrapper discovery.
  for ((i = 0; i < ${#compiler_flags[@]}; ++i)); do
    flag="${compiler_flags[i]}"
    case "$flag" in
      -fintrinsic-modules-path|-fintrinsic-modules-path=*)
        return
        ;;
      -resource-dir)
        if ((i + 1 < ${#compiler_flags[@]})); then
          resource_dir="${compiler_flags[i + 1]}"
        fi
        ;;
      -resource-dir=*)
        resource_dir="${flag#*=}"
        ;;
      --target|-target)
        if ((i + 1 < ${#compiler_flags[@]})); then
          target="${compiler_flags[i + 1]}"
        fi
        ;;
      --target=*|-target=*)
        target="${flag#*=}"
        ;;
    esac
  done

  if [[ -n "${FLANG_INTRINSIC_MODULES_PATH:-}" ]]; then
    intrinsic_dir="$FLANG_INTRINSIC_MODULES_PATH"
  elif [[ "$DRY_RUN" == "1" ]]; then
    FLANG_FRONTEND_FLAGS+=(
      "-fintrinsic-modules-path=<auto-flang-intrinsic-modules>"
    )
    return
  else
    if [[ -z "$resource_dir" ]]; then
      resource_dir="$("$FLANG" --print-resource-dir 2>/dev/null || true)"
      resource_dir="${resource_dir%%$'\n'*}"
    fi
    [[ -n "$resource_dir" && -d "$resource_dir" ]] ||
      die "could not determine Flang's resource directory; set FLANG_INTRINSIC_MODULES_PATH"

    if [[ -z "$target" ]]; then
      target="$("$FLANG" --print-target-triple 2>/dev/null || true)"
      target="${target%%$'\n'*}"
    fi

    if [[ -n "$target" &&
      -f "$resource_dir/finclude/flang/$target/iso_fortran_env.mod" ]]; then
      intrinsic_dir="$resource_dir/finclude/flang/$target"
    else
      while IFS= read -r module_file; do
        module_dirs+=("${module_file%/*}")
      done < <(
        find "$resource_dir/finclude/flang" -type f \
          -name iso_fortran_env.mod -print 2>/dev/null
      )

      if ((${#module_dirs[@]} == 1)); then
        intrinsic_dir="${module_dirs[0]}"
      elif ((${#module_dirs[@]} > 1)) && [[ -n "$target" ]]; then
        for flag in "${module_dirs[@]}"; do
          if [[ "$flag" == */"$target" ]]; then
            [[ -z "$intrinsic_dir" ]] ||
              die "multiple Flang intrinsic module directories match target '$target'; set FLANG_INTRINSIC_MODULES_PATH"
            intrinsic_dir="$flag"
          fi
        done
      fi
    fi
  fi

  [[ -n "$intrinsic_dir" &&
    -f "$intrinsic_dir/iso_fortran_env.mod" &&
    -f "$intrinsic_dir/iso_c_binding.mod" ]] ||
    die "could not find Flang's iso_fortran_env.mod and iso_c_binding.mod; set FLANG_INTRINSIC_MODULES_PATH"

  FLANG_FRONTEND_FLAGS+=("-fintrinsic-modules-path=$intrinsic_dir")
  if [[ "$VERBOSE" == "1" ]]; then
    log "Flang intrinsic modules: $intrinsic_dir"
  fi
}

resolve_nm() {
  if [[ -n "${NM:-}" ]]; then
    return
  fi
  if [[ -n "${LLVM_BUILD:-}" && -x "$LLVM_BUILD/bin/llvm-nm" ]]; then
    NM="$LLVM_BUILD/bin/llvm-nm"
  else
    NM="$(command -v llvm-nm || command -v nm || true)"
  fi
}

count_embedded_bundles() {
  local input="$1"
  local symbols marker_count register_count
  [[ -n "${NM:-}" && -f "$input" ]] || {
    printf '0\n'
    return
  }

  symbols="$($NM -A "$input" 2>/dev/null || true)"
  marker_count="$(grep -c '__fnacc_single_embedded_bundle' <<<"$symbols" || true)"
  if (( marker_count > 0 )); then
    printf '%s\n' "$marker_count"
    return
  fi
  register_count="$(grep -Ec '__fnacc_register_embedded_(device|kernel)_bundle' <<<"$symbols" || true)"
  printf '%s\n' "$register_count"
}

input_needs_fnacc_runtime() {
  local input="$1"
  local symbols
  [[ -n "${NM:-}" && -f "$input" ]] || return 1
  symbols="$("$NM" -A "$input" 2>/dev/null || true)"
  grep -q '__fnacc_' <<<"$symbols" || return 1
}

add_compile_only() {
  COMPILE_FLAGS+=("$@")
}

add_link_only() {
  LINK_SEQUENCE+=("$@")
}

add_compile_and_link() {
  COMPILE_FLAGS+=("$@")
  LINK_SEQUENCE+=("$@")
}

add_host_codegen_if_compatible() {
  local flag="$1"
  case "$flag" in
    -O*|-g*|-m*|-pthread|-fopenmp|-fPIC|-fpic|-fPIE|-fpie|-fno-pic|-fno-PIC|-fno-pie|-fno-PIE|\
    -ffast-math|-fno-fast-math|-fno-math-errno|-funsafe-math-optimizations|\
    -fno-omit-frame-pointer|-fomit-frame-pointer|-fstack-protector*|-fcf-protection*|\
    -fsanitize=*|-fno-sanitize=*)
      HOST_CODEGEN_FLAGS+=("$flag")
      ;;
  esac
}

record_input() {
  local input="$1"
  local index
  if is_fortran_source "$input" || is_fortran_language "$CURRENT_LANGUAGE"; then
    index="${#SOURCES[@]}"
    SOURCES+=("$input")
    LINK_SEQUENCE+=("__FNACC_SOURCE_${index}__")
  else
    OTHER_INPUTS+=("$input")
    LINK_SEQUENCE+=("$input")
  fi
}

SOURCES=()
SOURCE_IS_FNACC=()
SOURCE_OBJECTS=()
OTHER_INPUTS=()
LINK_SEQUENCE=()
COMPILE_FLAGS=()
HOST_CODEGEN_FLAGS=()
HOST_RELOCATE_FLAGS=()
FLANG_FRONTEND_FLAGS=()
FLANG_ARGS=()

OUTPUT=""
COMPILE_ONLY=0
PASSTHROUGH_ONLY=0
RELOCATABLE_LINK=0
CURRENT_LANGUAGE="none"
AFTER_DASH_DASH=0
HAS_LTO=0

FORCE_FNACC=0
DISABLE_FNACC=0
FORCE_RUNTIME=0
DISABLE_RUNTIME=0

ACCELERATOR_TARGET="${FNACC_TARGET:-cuda}"
GPU_ARCH="${FNACC_GPU_ARCH:-}"
SM="${FNACC_SM:-sm_90a}"
BACKEND="${FNACC_BACKEND:-auto}"
FALLBACK_BACKEND="${FNACC_FALLBACK_BACKEND:-triton}"
ALLOW_BACKEND_FALLBACK="${FNACC_ALLOW_BACKEND_FALLBACK:-true}"
LAUNCH_ABI="${FNACC_LAUNCH_ABI:-3}"
NUM_WARPS="${FNACC_NUM_WARPS:-1}"
THREADS_PER_WARP="${FNACC_THREADS_PER_WARP:-}"
NUM_STAGES="${FNACC_NUM_STAGES:-3}"
F64_MATMUL_STRATEGY="${FNACC_F64_MATMUL_STRATEGY:-reduce}"
CUDA_LIB_DIR="${CUDA_LIB_DIR:-}"
CUDA_LIBDEVICE="${FNACC_CUDA_LIBDEVICE:-}"
ROCM_PATH="${ROCM_PATH:-/opt/rocm}"
ROCM_DEVICE_LIB_DIR="${FNACC_ROCM_DEVICE_LIB_DIR:-}"
HIP_LIB_DIR="${FNACC_HIP_LIB_DIR:-}"
WORKDIR_PARENT="${FNACC_WORKDIR:-}"

KEEP=0
VERBOSE=0
DRY_RUN=0
STOP_AFTER=""
USER_WORKDIR_SET=0

while [[ $# -gt 0 ]]; do
  if [[ "$AFTER_DASH_DASH" == "1" ]]; then
    FLANG_ARGS+=("$1")
    record_input "$1"
    shift
    continue
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --fnacc-force)
      FORCE_FNACC=1
      shift
      ;;
    --fnacc-disable)
      DISABLE_FNACC=1
      shift
      ;;
    --fnacc-runtime)
      FORCE_RUNTIME=1
      shift
      ;;
    --fnacc-no-runtime)
      DISABLE_RUNTIME=1
      shift
      ;;
    --fnacc-sm|--sm)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      SM="$2"
      shift 2
      ;;
    --fnacc-target)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      ACCELERATOR_TARGET="$2"
      shift 2
      ;;
    --fnacc-target=*)
      ACCELERATOR_TARGET="${1#*=}"
      shift
      ;;
    --fnacc-gpu-arch)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      GPU_ARCH="$2"
      shift 2
      ;;
    --fnacc-gpu-arch=*)
      GPU_ARCH="${1#*=}"
      shift
      ;;
    --fnacc-amd-arch)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      ACCELERATOR_TARGET=hip
      GPU_ARCH="$2"
      shift 2
      ;;
    --fnacc-amd-arch=*)
      ACCELERATOR_TARGET=hip
      GPU_ARCH="${1#*=}"
      shift
      ;;
    --fnacc-backend)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      BACKEND="$2"
      shift 2
      ;;
    --fnacc-backend=*)
      BACKEND="${1#*=}"
      shift
      ;;
    --fnacc-fallback-backend)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FALLBACK_BACKEND="$2"
      shift 2
      ;;
    --fnacc-fallback-backend=*)
      FALLBACK_BACKEND="${1#*=}"
      shift
      ;;
    --fnacc-backend-fallback)
      ALLOW_BACKEND_FALLBACK=true
      shift
      ;;
    --fnacc-no-backend-fallback)
      ALLOW_BACKEND_FALLBACK=false
      shift
      ;;
    --fnacc-launch-abi)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      LAUNCH_ABI="$2"
      shift 2
      ;;
    --fnacc-num-warps|--num-warps)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      NUM_WARPS="$2"
      shift 2
      ;;
    --fnacc-threads-per-warp|--threads-per-warp)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      THREADS_PER_WARP="$2"
      shift 2
      ;;
    --fnacc-num-stages|--num-stages)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      NUM_STAGES="$2"
      shift 2
      ;;
    --fnacc-f64-matmul-strategy|--f64-matmul-strategy)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      F64_MATMUL_STRATEGY="$2"
      shift 2
      ;;
    --fnacc-cuda-lib-dir|--cuda-lib-dir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      CUDA_LIB_DIR="$2"
      shift 2
      ;;
    --fnacc-cuda-libdevice|--cuda-libdevice)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      CUDA_LIBDEVICE="$2"
      shift 2
      ;;
    --fnacc-cuda-libdevice=*|--cuda-libdevice=*)
      CUDA_LIBDEVICE="${1#*=}"
      shift
      ;;
    --fnacc-rocm-path)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      ROCM_PATH="$2"
      shift 2
      ;;
    --fnacc-rocm-path=*)
      ROCM_PATH="${1#*=}"
      shift
      ;;
    --fnacc-rocm-device-lib-dir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      ROCM_DEVICE_LIB_DIR="$2"
      shift 2
      ;;
    --fnacc-rocm-device-lib-dir=*)
      ROCM_DEVICE_LIB_DIR="${1#*=}"
      shift
      ;;
    --fnacc-hip-lib-dir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      HIP_LIB_DIR="$2"
      shift 2
      ;;
    --fnacc-hip-lib-dir=*)
      HIP_LIB_DIR="${1#*=}"
      shift
      ;;
    --fnacc-workdir|--workdir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      WORKDIR_PARENT="$2"
      USER_WORKDIR_SET=1
      shift 2
      ;;
    --fnacc-keep|--keep|-save-temps)
      KEEP=1
      [[ "$1" != "-save-temps" ]] || FLANG_ARGS+=("$1")
      shift
      ;;
    --fnacc-verbose|--verbose)
      VERBOSE=1
      shift
      ;;
    --fnacc-dry-run|--dry-run)
      DRY_RUN=1
      shift
      ;;
    --fnacc-stop-after|--stop-after)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      STOP_AFTER="$2"
      KEEP=1
      shift 2
      ;;
    --fflag)
      [[ $# -ge 2 ]] || die "--fflag requires an argument"
      add_compile_only "$2"
      shift 2
      ;;
    --ldflag)
      [[ $# -ge 2 ]] || die "--ldflag requires an argument"
      add_link_only "$2"
      shift 2
      ;;
    --lib)
      [[ $# -ge 2 ]] || die "--lib requires an argument"
      add_link_only "-l$2"
      shift 2
      ;;
    --kernel-src|--main-src|--extra-src)
      die "$1 belongs to the restricted wrapper; pass the source filename directly"
      ;;
    --no-embed|--runner-uses-files|--fnacc-no-embed)
      die "$1 is incompatible with self-contained, separately linkable objects"
      ;;
    -c)
      COMPILE_ONLY=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    -E|-S|-fsyntax-only)
      PASSTHROUGH_ONLY=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    -r)
      RELOCATABLE_LINK=1
      FLANG_ARGS+=("$1")
      add_link_only "$1"
      shift
      ;;
    -o)
      [[ $# -ge 2 ]] || die "-o requires an argument"
      OUTPUT="$2"
      FLANG_ARGS+=("$1" "$2")
      shift 2
      ;;
    -o?*)
      OUTPUT="${1#-o}"
      FLANG_ARGS+=("$1")
      shift
      ;;
    -x)
      [[ $# -ge 2 ]] || die "-x requires an argument"
      CURRENT_LANGUAGE="$2"
      FLANG_ARGS+=("$1" "$2")
      add_compile_only "$1" "$2"
      shift 2
      ;;
    -I|-J|-D|-U|-isystem|-iquote|-idirafter|-include|-module-dir|-fintrinsic-modules-path|-Xflang|-Xpreprocessor|-Xassembler|-MF|-MT|-MQ|-dependency-file)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_compile_only "$1" "$2"
      if [[ "$1" == "-Xassembler" ]]; then
        HOST_CODEGEN_FLAGS+=("$1" "$2")
      fi
      shift 2
      ;;
    -M|-MM|-MD|-MMD|-MP|-MG)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      shift
      ;;
    -I?*|-J?*|-D?*|-U?*|-isystem?*|-iquote?*|-idirafter?*|-include?*|-module-dir=*|-fintrinsic-modules-path=*)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      shift
      ;;
    -L|-l|-Xlinker|-Xoffload-linker|-u|-T|-framework|-weak_framework|-undefined|-Wl)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_link_only "$1" "$2"
      shift 2
      ;;
    -L?*|-l?*|-Wl,*|-shared|-static|-static-pie|-pie|-no-pie|-rdynamic|-s|-nostdlib|-nodefaultlibs|-nostartfiles)
      FLANG_ARGS+=("$1")
      add_link_only "$1"
      shift
      ;;
    --target|-target|--sysroot|-isysroot|-resource-dir|-gcc-toolchain|--gcc-toolchain|-B|-mcpu|-march|-mtune)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_compile_and_link "$1" "$2"
      HOST_CODEGEN_FLAGS+=("$1" "$2")
      HOST_RELOCATE_FLAGS+=("$1" "$2")
      shift 2
      ;;
    --target=*|--sysroot=*|-fuse-ld=*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      HOST_CODEGEN_FLAGS+=("$1")
      HOST_RELOCATE_FLAGS+=("$1")
      shift
      ;;
    -flto|-flto=*)
      HAS_LTO=1
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      shift
      ;;
    -Wa,*|-Wp,*)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      [[ "$1" != -Wa,* ]] || HOST_CODEGEN_FLAGS+=("$1")
      shift
      ;;
    --)
      AFTER_DASH_DASH=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    @*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      shift
      ;;
    -*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      add_host_codegen_if_compatible "$1"
      case "$1" in
        -m32|-m64) HOST_RELOCATE_FLAGS+=("$1") ;;
      esac
      shift
      ;;
    *)
      FLANG_ARGS+=("$1")
      record_input "$1"
      shift
      ;;
  esac
done

[[ "$FORCE_FNACC" == "0" || "$DISABLE_FNACC" == "0" ]] ||
  die "--fnacc-force and --fnacc-disable are mutually exclusive"
[[ "$FORCE_RUNTIME" == "0" || "$DISABLE_RUNTIME" == "0" ]] ||
  die "--fnacc-runtime and --fnacc-no-runtime are mutually exclusive"

resolve_flang

if [[ "$PASSTHROUGH_ONLY" == "1" ]]; then
  run "$FLANG" "${FLANG_ARGS[@]}"
  exit 0
fi

if [[ ${#SOURCES[@]} -eq 0 && ${#OTHER_INPUTS[@]} -eq 0 ]]; then
  if [[ ${#FLANG_ARGS[@]} -gt 0 ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi
  die "no input files"
fi

for source in "${SOURCES[@]}"; do
  [[ "$source" == "-" ]] || require_file "$source"
done

for source in "${SOURCES[@]}"; do
  if [[ "$DISABLE_FNACC" == "1" ]]; then
    SOURCE_IS_FNACC+=(0)
  elif [[ "$FORCE_FNACC" == "1" ]]; then
    [[ "$source" != "-" ]] || die "FNACC compilation from standard input is not supported"
    SOURCE_IS_FNACC+=(1)
  elif source_has_fnacc "$source"; then
    SOURCE_IS_FNACC+=(1)
  else
    SOURCE_IS_FNACC+=(0)
  fi
done

FNACC_SOURCE_COUNT=0
for value in "${SOURCE_IS_FNACC[@]}"; do
  (( FNACC_SOURCE_COUNT += value )) || true
done

if [[ -n "$STOP_AFTER" && "$FNACC_SOURCE_COUNT" -ne 1 ]]; then
  die "--fnacc-stop-after requires exactly one FNACC source"
fi

if [[ "$COMPILE_ONLY" == "1" && -n "$OUTPUT" && ${#SOURCES[@]} -ne 1 ]]; then
  die "cannot use -o with -c and multiple source files"
fi

if [[ "$COMPILE_ONLY" == "1" && ${#OTHER_INPUTS[@]} -gt 0 && "$FNACC_SOURCE_COUNT" -gt 0 ]]; then
  die "object and library inputs are not accepted with -c"
fi

if [[ "$FNACC_SOURCE_COUNT" == "0" && "$FORCE_RUNTIME" == "0" ]]; then
  if [[ "$COMPILE_ONLY" == "1" ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi

  resolve_nm
  EXISTING_FNACC=0
  for input in "${OTHER_INPUTS[@]}"; do
    if input_needs_fnacc_runtime "$input"; then
      EXISTING_FNACC=1
      break
    fi
  done
  if [[ "$EXISTING_FNACC" == "0" ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi
fi

case "$STOP_AFTER" in
  ""|modgen|fir|fnacc-pipeline|ttgir|llvm-mlir|llvm-ir|ptx|hsaco|device-image|embed|host-ll|host-obj|object|objects|link)
    ;;
  *)
    die "invalid --fnacc-stop-after stage: $STOP_AFTER"
    ;;
esac

case "$LAUNCH_ABI" in
  2|3) ;;
  *) die "invalid FNACC launch ABI '$LAUNCH_ABI'; expected 2 or 3" ;;
esac

case "$F64_MATMUL_STRATEGY" in
  reduce|fma|dot) ;;
  *) die "invalid FNACC F64 matmul strategy '$F64_MATMUL_STRATEGY'; expected reduce, fma, or dot" ;;
esac

if (( FNACC_SOURCE_COUNT > 0 )); then
  ALLOW_BACKEND_FALLBACK="$(normalize_bool "$ALLOW_BACKEND_FALLBACK")"
  [[ "$BACKEND" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] ||
    die "invalid FNACC backend name '$BACKEND'"
  [[ "$FALLBACK_BACKEND" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] ||
    die "invalid FNACC fallback backend name '$FALLBACK_BACKEND'"

  case "${ACCELERATOR_TARGET,,}" in
    cuda|nvidia) ACCELERATOR_TARGET=cuda ;;
    hip|amd|rocm) ACCELERATOR_TARGET=hip ;;
    *) die "invalid FNACC target '$ACCELERATOR_TARGET'; expected cuda or hip" ;;
  esac

  if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
    if [[ -n "$GPU_ARCH" ]]; then
      SM="$GPU_ARCH"
    fi
    SM="${SM#sm_}"
    SM="${SM#cc}"
    [[ "$SM" =~ ^[0-9]+a?$ ]] ||
      die "invalid CUDA SM value '$SM'; expected e.g. 80, sm_80, cc80, or sm_90a"
    SM_NUM="${SM%a}"
    SM_SUFFIX="${SM#$SM_NUM}"
    SM_NUM=$((10#$SM_NUM))
    SM="${SM_NUM}${SM_SUFFIX}"
    GPU_ARCH="sm_$SM"
    TRITON_TARGET="cuda:$SM_NUM"
    [[ -n "$THREADS_PER_WARP" ]] || THREADS_PER_WARP=32
  else
    [[ -n "$GPU_ARCH" ]] || GPU_ARCH="${FNACC_AMD_GPU_ARCH:-gfx90a}"
    GPU_ARCH="${GPU_ARCH#amd:}"
    [[ "$GPU_ARCH" =~ ^gfx[0-9a-f]+$ ]] ||
      die "invalid AMD GPU architecture '$GPU_ARCH'; expected e.g. gfx90a or gfx942"
    if [[ -z "$THREADS_PER_WARP" ]]; then
      # CDNA/gfx9 uses wave64; RDNA/gfx10+ uses wave32 by default.
      if [[ "$GPU_ARCH" =~ ^gfx9 ]]; then
        THREADS_PER_WARP=64
      else
        THREADS_PER_WARP=32
      fi
    fi
    TRITON_TARGET="hip:$GPU_ARCH"
  fi

  [[ "$NUM_WARPS" =~ ^[0-9]+$ ]] || die "invalid num-warps value '$NUM_WARPS'"
  [[ "$THREADS_PER_WARP" =~ ^[0-9]+$ ]] || die "invalid threads-per-warp value '$THREADS_PER_WARP'"
  [[ "$NUM_STAGES" =~ ^[0-9]+$ ]] || die "invalid num-stages value '$NUM_STAGES'"
  if (( ${#NUM_WARPS} > 3 || ${#THREADS_PER_WARP} > 3 || ${#NUM_STAGES} > 2 )); then
    die "numeric FNACC launch option is outside the supported range"
  fi

  NUM_WARPS=$((10#$NUM_WARPS))
  THREADS_PER_WARP=$((10#$THREADS_PER_WARP))
  NUM_STAGES=$((10#$NUM_STAGES))

  (( NUM_WARPS > 0 )) || die "num-warps must be positive"
  (( (NUM_WARPS & (NUM_WARPS - 1)) == 0 )) || die "num-warps must be a power of two"
  (( NUM_WARPS <= 32 )) || die "num-warps must not exceed 32"
  if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
    (( THREADS_PER_WARP == 32 )) ||
      die "CUDA lowering requires --fnacc-threads-per-warp 32"
  else
    (( THREADS_PER_WARP == 32 || THREADS_PER_WARP == 64 )) ||
      die "HIP lowering requires --fnacc-threads-per-warp 32 or 64"
  fi
  (( NUM_STAGES > 0 && NUM_STAGES <= 16 )) || die "num-stages must be between 1 and 16"
  [[ "$HAS_LTO" == "0" ]] || die "LTO is not supported when compiling an FNACC source"

  [[ -n "${LLVM_BUILD:-}" ]] || die "LLVM_BUILD is required for FNACC compilation"
  FIROPT="${FIROPT:-$LLVM_BUILD/bin/fir-opt}"
  TCO="${TCO:-$LLVM_BUILD/bin/tco}"
  CLANG="${CLANG:-$LLVM_BUILD/bin/clang}"
  TRITON_OPT="${TRITON_OPT:-}"
  MLIR_TRANSLATE="${MLIR_TRANSLATE:-}"
  LLVM_LINK="${LLVM_LINK:-$LLVM_BUILD/bin/llvm-link}"
  OPT="${OPT:-$LLVM_BUILD/bin/opt}"
  LLC="${LLC:-}"
  LD_LLD="${LD_LLD:-$ROCM_PATH/llvm/bin/ld.lld}"

  require_exe "$FIROPT"
  require_exe "$TCO"
  require_exe "$CLANG"
fi

if [[ -n "$CUDA_LIB_DIR" && ! -d "$CUDA_LIB_DIR" ]]; then
  die "CUDA library directory does not exist: $CUDA_LIB_DIR"
fi

if (( FNACC_SOURCE_COUNT > 0 )) && \
    [[ "$ACCELERATOR_TARGET" == "cuda" && -n "$CUDA_LIBDEVICE" && ! -f "$CUDA_LIBDEVICE" ]]; then
  die "CUDA libdevice bitcode does not exist: $CUDA_LIBDEVICE"
fi

if (( FNACC_SOURCE_COUNT > 0 )) && [[ "$ACCELERATOR_TARGET" == "hip" ]]; then
  [[ -d "$ROCM_PATH" ]] || die "ROCm installation does not exist: $ROCM_PATH"
  if [[ -n "$ROCM_DEVICE_LIB_DIR" && ! -d "$ROCM_DEVICE_LIB_DIR" ]]; then
    die "ROCm device-library directory does not exist: $ROCM_DEVICE_LIB_DIR"
  fi
  if [[ -z "$HIP_LIB_DIR" ]]; then
    if [[ -d "$ROCM_PATH/lib" ]]; then
      HIP_LIB_DIR="$ROCM_PATH/lib"
    elif [[ -d "$ROCM_PATH/lib64" ]]; then
      HIP_LIB_DIR="$ROCM_PATH/lib64"
    fi
  fi
fi

if [[ -n "$WORKDIR_PARENT" && "$WORKDIR_PARENT" =~ [[:space:]] ]]; then
  die "FNACC work directories must not contain whitespace because MLIR pass options cannot represent it safely"
fi

if [[ -n "$OUTPUT" ]]; then
  WORK_BASE="$(sanitize_stem "$OUTPUT")"
elif [[ ${#SOURCES[@]} -gt 0 ]]; then
  WORK_BASE="$(sanitize_stem "${SOURCES[0]}")"
else
  WORK_BASE="link"
fi

if [[ "$DRY_RUN" == "1" ]]; then
  if [[ -n "$WORKDIR_PARENT" ]]; then
    WORKDIR="$WORKDIR_PARENT/fnacc-${WORK_BASE}.dry-run"
  else
    WORKDIR="${TMPDIR:-$PWD}/fnacc-${WORK_BASE}.dry-run"
  fi
else
  if [[ -z "$WORKDIR_PARENT" ]]; then
    WORKDIR_PARENT="${TMPDIR:-/tmp}"
    if [[ ! -d "$WORKDIR_PARENT" || ! -w "$WORKDIR_PARENT" ]]; then
      WORKDIR_PARENT="$PWD"
    fi
  fi
  [[ ! "$WORKDIR_PARENT" =~ [[:space:]] ]] ||
    die "no writable whitespace-free temporary directory is available"
  mkdir -p "$WORKDIR_PARENT"
  WORKDIR="$(mktemp -d "$WORKDIR_PARENT/fnacc-${WORK_BASE}.XXXXXX")"
fi

OBJ_DIR="$WORKDIR/obj"
if [[ "$DRY_RUN" != "1" ]]; then
  mkdir -p "$OBJ_DIR"
fi

cleanup() {
  if [[ "$KEEP" != "1" && "$DRY_RUN" != "1" ]]; then
    rm -rf "$WORKDIR"
  fi
}
trap cleanup EXIT

if ((FNACC_SOURCE_COUNT > 0)); then
  resolve_flang_intrinsic_modules "${COMPILE_FLAGS[@]}"
fi

if (( FNACC_SOURCE_COUNT > 0 )) && [[ "$DRY_RUN" != "1" ]]; then
  write_toolchain_manifest "$WORKDIR/toolchain.txt"
fi

compile_plain_source() {
  local source="$1"
  local output="$2"
  log "compile Fortran: $source -> $output"
  run "$FLANG" "${COMPILE_FLAGS[@]}" -c "$source" -o "$output"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$output" || die "object was not generated: $output"
  fi
}

compile_fnacc_source() {
  local source="$1"
  local output="$2"
  local stem source_hash base_path
  local fir host_fir host_ll host_obj
  local ttir json split_dir manifest embed_c embed_obj
  local effective_num_warps count
  local data_only=0
  local BACKEND="$BACKEND"
  local CUDA_TILE_TRANSLATE="${FNACC_CUDA_TILE_TRANSLATE:-cuda-tile-translate}"
  local TILEIRAS="${FNACC_TILEIRAS:-tileiras}"
  if [[ "$BACKEND" == "cuda-tile" ]]; then
    local tile_target_supported=0

    if [[ "$ACCELERATOR_TARGET" == "cuda" &&
          "$SM_NUM" =~ ^[0-9]+$ ]]; then
      if (( 10#$SM_NUM >= 80 )); then
        tile_target_supported=1
      fi
    fi

    if (( ! tile_target_supported )); then
      if [[ "$ALLOW_BACKEND_FALLBACK" == "true" &&
            "$FALLBACK_BACKEND" == "triton" ]]; then
        log "  CUDA Tile requires sm_80 or newer; falling back to Triton for $GPU_ARCH"
        BACKEND=triton
      else
        die "CUDA Tile requires a CUDA target sm_80 or newer (or enable Triton fallback)"
      fi
    fi
  fi
  local selected_backend device_ir_kind device_image_kind metadata_target used_backend_fallback
  local ki kernel_name kernel_warps kernel_ttir kernel_ttgir kernel_llvm_mlir
  local kernel_ll kernel_linked_bc kernel_optimized_bc kernel_codegen_ir kernel_ptx
  local kernel_object kernel_hsaco kernel_image

  stem="$(sanitize_stem "$source")"
  source_hash="$(hash_path "$source")"
  base_path="$WORKDIR/${stem}_${source_hash}"
  fir="$base_path.fir"
  host_fir="$base_path.host.fir"
  host_ll="$base_path.host.ll"
  host_obj="$base_path.host.o"
  ttir="$base_path.kernels.ttir"
  json="$base_path.kernels.json"
  split_dir="$base_path.kernels.split"
  manifest="$base_path.kernels.manifest.json"
  embed_c="$base_path.embedded.c"
  embed_obj="$base_path.embedded.o"

  log "FNACC compile: $source -> $output"
  log "  host launch ABI: $LAUNCH_ABI"
  log "  target: $ACCELERATOR_TARGET:$GPU_ARCH, backend=$BACKEND, fallback=$FALLBACK_BACKEND, warps=$NUM_WARPS, threads/subgroup=$THREADS_PER_WARP, stages=$NUM_STAGES"

  log "  [1/10] Generate Fortran module files"
  run "$FLANG" -fsyntax-only "$source" "${COMPILE_FLAGS[@]}"
  maybe_stop modgen

  log "  [2/10] Emit FIR"
  run "$FLANG" -fc1 -emit-fir \
    "${FLANG_FRONTEND_FLAGS[@]}" \
    "$source" "${COMPILE_FLAGS[@]}" -o "$fir"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$fir" || die "FIR was not generated: $fir"
  fi
  maybe_stop fir

  log "  [3/10] Run FNACC pipeline"
  run env "FNACC_KERNEL_BUNDLE_KEY=$source_hash" "$FIROPT" \
    "--fnacc-pipeline=ttir-output=$ttir json-output=$json \
      emit-fortran-aliases=true \
      launch-abi=$LAUNCH_ABI \
      num-warps=$NUM_WARPS \
      threads-per-warp=$THREADS_PER_WARP \
      num-stages=$NUM_STAGES \
      f64-matmul-strategy=$F64_MATMUL_STRATEGY \
      accelerator-target=$ACCELERATOR_TARGET \
      backend=$BACKEND \
      fallback-backend=$FALLBACK_BACKEND \
      allow-backend-fallback=$ALLOW_BACKEND_FALLBACK" \
    "$fir" -o "$host_fir"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$ttir" || die "device IR was not generated: $ttir"
    test -s "$json" || die "JSON was not generated: $json"
    test -s "$host_fir" || die "host FIR was not generated: $host_fir"
    validate_json "$json"
    validate_kernel_json "$json"
    count="$(kernel_json_count "$json")"
    if (( count == 0 )); then
      if fir_has_fnacc_launch "$fir" || source_has_fnacc_parallel "$source"; then
        if [[ "${FNACC_ALLOW_EMPTY_KERNELS:-0}" != "1" ]]; then
          die "no kernels were emitted into $json even though an FNACC parallel launch was present; set FNACC_ALLOW_EMPTY_KERNELS=1 to override this check"
        fi
        warn "accepting an empty kernel bundle despite an FNACC parallel launch"
      fi
      data_only=1
    else
      IFS=$'\t' read -r selected_backend device_ir_kind device_image_kind metadata_target used_backend_fallback \
        < <(read_backend_contract "$json")
      [[ "$metadata_target" == "$ACCELERATOR_TARGET" ]] ||
        die "compiler emitted target '$metadata_target' while '$ACCELERATOR_TARGET' was requested"
    fi
  else
    if [[ "$BACKEND" == "auto" || "$BACKEND" == "triton" ]]; then
      selected_backend=triton
      device_ir_kind=ttir
      if [[ "$ACCELERATOR_TARGET" == "hip" ]]; then
        device_image_kind=hsaco
      else
        device_image_kind=ptx
      fi
      metadata_target="$ACCELERATOR_TARGET"
      used_backend_fallback=false
    elif [[ "$BACKEND" == "cuda-tile" ]]; then
      selected_backend=cuda-tile
      device_ir_kind=cuda-tile-ir
      device_image_kind=cubin
      metadata_target=cuda
      used_backend_fallback=false
    elif [[ "$ALLOW_BACKEND_FALLBACK" == "true" &&
            "$FALLBACK_BACKEND" == "triton" ]]; then
      selected_backend=triton
      device_ir_kind=ttir
      if [[ "$ACCELERATOR_TARGET" == "hip" ]]; then
        device_image_kind=hsaco
      else
        device_image_kind=ptx
      fi
      metadata_target="$ACCELERATOR_TARGET"
      used_backend_fallback=true
    else
      selected_backend="$BACKEND"
      device_ir_kind=unknown
      device_image_kind=unknown
      metadata_target="$ACCELERATOR_TARGET"
      used_backend_fallback=false
    fi
  fi
  maybe_stop fnacc-pipeline

  if (( data_only )); then
    log "  no device kernels: emitting a host-only FNACC object"
    log "  [4-9/10] Skip device code generation and kernel embedding"
    maybe_stop ttgir
    maybe_stop llvm-mlir
    maybe_stop llvm-ir
    maybe_stop ptx
    maybe_stop embed

    log "  [10/10] Generate host object"
    run "$TCO" "$host_fir" -o "$host_ll"
    test -s "$host_ll" || die "host LLVM IR was not generated: $host_ll"
    maybe_stop host-ll

    run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$host_ll" -o "$output"
    test -s "$output" || die "FNACC object was not generated: $output"
    maybe_stop host-obj
    maybe_stop object
    return
  fi

  log "  selected backend: $selected_backend (device IR=$device_ir_kind, image=$device_image_kind, fallback=$used_backend_fallback)"

  case "$selected_backend:$device_ir_kind:$device_image_kind" in
    triton:ttir:ptx|triton:ttir:hsaco|mixed:mixed:mixed)
      require_triton_toolchain
      if [[ "$device_image_kind" == "hsaco" ]]; then require_exe "$LD_LLD"; fi
      ;;
    cuda-tile:cuda-tile-ir:cubin) ;;
    *) die "unsupported backend pipeline: $selected_backend:$device_ir_kind:$device_image_kind" ;;
  esac
  if [[ "$selected_backend" == "cuda-tile" || "$selected_backend" == "mixed" ]]; then
    CUDA_TILE_TRANSLATE="$(command -v "$CUDA_TILE_TRANSLATE" || true)"
    TILEIRAS="$(command -v "$TILEIRAS" || true)"
    require_exe "$CUDA_TILE_TRANSLATE"
    require_exe "$TILEIRAS"
  fi

  effective_num_warps="$NUM_WARPS"
  if [[ "$DRY_RUN" != "1" ]]; then
    effective_num_warps="$(read_effective_num_warps_from_json "$json" "$NUM_WARPS")"
  fi
  log "  effective warps: $effective_num_warps"

  if [[ "$DRY_RUN" == "1" ]]; then
    quote_cmd python3 "<split-ttir-helper>" "$ttir" "$json" "$split_dir" "$manifest"
    if [[ "$selected_backend" == "cuda-tile" || "$selected_backend" == "mixed" ]]; then
      quote_cmd "$CUDA_TILE_TRANSLATE" "<kernel.cuda-tile.mlir>" --bytecode-version=13.1 --mlir-to-cudatilebc --no-implicit-module -o "<kernel.tilebc>"
      quote_cmd "$TILEIRAS" --gpu-name "$GPU_ARCH" "<kernel.tilebc>" -o "<kernel.cubin>"
    fi
    if [[ "$selected_backend" != "cuda-tile" ]]; then
    quote_cmd "$TRITON_OPT" "<kernel.ttir>" \
      "--convert-triton-to-tritongpu=target=$TRITON_TARGET num-warps=<kernel-warps>" \
      -o "<kernel.ttgir.mlir>"
    maybe_stop ttgir
    quote_cmd "$TRITON_OPT" "<kernel.ttgir.mlir>" "<configured-lowering-passes>" \
      -o "<kernel.llvm.mlir>"
    maybe_stop llvm-mlir
    quote_cmd "$MLIR_TRANSLATE" --mlir-to-llvmir "<kernel.llvm.mlir>" -o "<kernel.ll>"
    maybe_stop llvm-ir
    if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
      log "  link CUDA libdevice only for kernels that reference __nv_* functions"
      quote_cmd "$LLVM_LINK" --only-needed "<kernel.ll>" \
        "${CUDA_LIBDEVICE:-<cuda>/nvvm/libdevice/libdevice.10.bc}" \
        -o "<kernel.libdevice-linked.bc>"
      quote_cmd "$OPT" "-passes=default<O3>" \
        "<kernel.libdevice-linked.bc>" -o "<kernel.libdevice-opt.bc>"
      quote_cmd "$LLC" -march=nvptx64 "-mcpu=sm_$SM" \
        "<kernel.ll-or-libdevice-opt.bc>" -o "<kernel.ptx>"
      maybe_stop ptx
    else
      log "  link ROCm device libraries only for kernels that reference OCML/OCKL"
      quote_cmd "$LLVM_LINK" --only-needed "<kernel.ll>" \
        "${ROCM_DEVICE_LIB_DIR:-<rocm>/amdgcn/bitcode}/{ocml,ockl,oclc_*}.bc" \
        -o "<kernel.rocm-linked.bc>"
      quote_cmd "$LLC" -march=amdgcn "-mcpu=$GPU_ARCH" -filetype=obj \
        "<kernel.ll-or-rocm-opt.bc>" -o "<kernel.amdgpu.o>"
      quote_cmd "$LD_LLD" -shared --no-undefined "<kernel.amdgpu.o>" \
        -o "<kernel.hsaco>"
      maybe_stop hsaco
    fi
    fi
    maybe_stop device-image
  else
    log "  [4/10] Split TTIR per kernel"
    split_ttir_per_kernel "$ttir" "$json" "$split_dir" "$manifest"
    test -s "$manifest" || die "kernel manifest was not generated: $manifest"
    count="$(manifest_count "$manifest")"

    for ((ki = 0; ki < count; ++ki)); do
      if [[ "$(manifest_get "$manifest" "$ki" backend)" != "cuda-tile" ]]; then continue; fi
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_ttir="$(manifest_get "$manifest" "$ki" ttir)"
      kernel_image="$(manifest_get "$manifest" "$ki" image)"
      log "  CUDA Tile: $kernel_name -> cubin"
      run "$CUDA_TILE_TRANSLATE" "$kernel_ttir" --bytecode-version=13.1 \
        --mlir-to-cudatilebc --no-implicit-module -o "$kernel_ttir.tilebc"
      run "$TILEIRAS" --gpu-name "$GPU_ARCH" "$kernel_ttir.tilebc" -o "$kernel_image"
      test -s "$kernel_image" || die "CUDA Tile image not generated: $kernel_name"
    done
    log "  [5/10] Lower Triton kernels to TTGIR"
    for ((ki = 0; ki < count; ++ki)); do
      if [[ "$(manifest_get "$manifest" "$ki" backend)" == "cuda-tile" ]]; then continue; fi
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_warps="$(manifest_get "$manifest" "$ki" num_warps)"
      kernel_ttir="$(manifest_get "$manifest" "$ki" ttir)"
      kernel_ttgir="$(manifest_get "$manifest" "$ki" ttgir)"
      if [[ "$ACCELERATOR_TARGET" == "hip" &&
            -n "${FNACC_HIP_TTIR_TO_TTGIR_PASSES:-}" ]]; then
        mapfile -t TTIR_TO_TTGIR_PASSES < <(split_pass_pipeline "$FNACC_HIP_TTIR_TO_TTGIR_PASSES")
        run "$TRITON_OPT" "$kernel_ttir" "${TTIR_TO_TTGIR_PASSES[@]}" -o "$kernel_ttgir"
      elif [[ -n "${FNACC_TTIR_TO_TTGIR_PASSES:-}" ]]; then
        mapfile -t TTIR_TO_TTGIR_PASSES < <(split_pass_pipeline "$FNACC_TTIR_TO_TTGIR_PASSES")
        run "$TRITON_OPT" "$kernel_ttir" "${TTIR_TO_TTGIR_PASSES[@]}" -o "$kernel_ttgir"
      elif [[ "$ACCELERATOR_TARGET" == "hip" ]]; then
        run "$TRITON_OPT" "$kernel_ttir" \
          "--convert-triton-to-tritongpu=target=$TRITON_TARGET num-warps=$kernel_warps" \
          "--tritonamdgpu-accelerate-matmul=gfx-arch=$GPU_ARCH" \
          --canonicalize --cse -o "$kernel_ttgir"
      else
        local -a matmul_precision_passes=()
        if [[ "$(kernel_matmul_precision "$json" "$kernel_name")" == "tf32x3" ]]; then
          # Expand compensated FP32 dots before selecting tensor-core layouts.
          matmul_precision_passes+=(--tritongpu-coalesce --tritongpu-F32DotTC)
        fi
        run "$TRITON_OPT" "$kernel_ttir" \
          "--convert-triton-to-tritongpu=target=cuda:$SM_NUM num-warps=$kernel_warps" \
          "${matmul_precision_passes[@]}" \
          --tritongpu-accelerate-matmul --canonicalize --cse -o "$kernel_ttgir"
      fi
      test -s "$kernel_ttgir" || die "TTGIR was not generated for $kernel_name"
    done
    maybe_stop ttgir

    log "  [6/10] Lower TTGIR to LLVM MLIR"
    for ((ki = 0; ki < count; ++ki)); do
      if [[ "$(manifest_get "$manifest" "$ki" backend)" == "cuda-tile" ]]; then continue; fi
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_ttgir="$(manifest_get "$manifest" "$ki" ttgir)"
      kernel_llvm_mlir="$(manifest_get "$manifest" "$ki" llvm_mlir)"
      if [[ "$ACCELERATOR_TARGET" == "hip" &&
            -n "${FNACC_HIP_TTGIR_TO_LLVM_PASSES:-}" ]]; then
        mapfile -t TTGIR_TO_LLVM_PASSES < <(split_pass_pipeline "$FNACC_HIP_TTGIR_TO_LLVM_PASSES")
        run "$TRITON_OPT" "$kernel_ttgir" "${TTGIR_TO_LLVM_PASSES[@]}" -o "$kernel_llvm_mlir"
      elif [[ -n "${FNACC_TTGIR_TO_LLVM_PASSES:-}" ]]; then
        mapfile -t TTGIR_TO_LLVM_PASSES < <(split_pass_pipeline "$FNACC_TTGIR_TO_LLVM_PASSES")
        run "$TRITON_OPT" "$kernel_ttgir" "${TTGIR_TO_LLVM_PASSES[@]}" -o "$kernel_llvm_mlir"
      elif [[ "$ACCELERATOR_TARGET" == "hip" ]]; then
        run "$TRITON_OPT" "$kernel_ttgir" \
          --tritongpu-coalesce \
          --tritongpu-remove-layout-conversions \
          --tritongpu-optimize-thread-locality \
          --allocate-shared-memory \
          --convert-scf-to-cf \
          --canonicalize \
          --cse \
          "--convert-triton-amdgpu-to-llvm=arch=$GPU_ARCH" \
          --convert-index-to-llvm \
          --convert-arith-to-llvm \
          --convert-math-to-llvm \
          --convert-cf-to-llvm \
          --reconcile-unrealized-casts \
          --canonicalize \
          --cse \
          -o "$kernel_llvm_mlir"
      else
        run "$TRITON_OPT" "$kernel_ttgir" \
          --tritongpu-coalesce \
          --tritongpu-remove-layout-conversions \
          --tritongpu-optimize-thread-locality \
          --triton-nvidia-gpu-plan-cta \
          --tritongpu-allocate-warp-groups \
          --triton-nvidia-mma-lowering \
          --allocate-shared-memory-nv \
          --convert-scf-to-cf \
          --canonicalize \
          --cse \
          --convert-triton-gpu-to-llvm \
          --canonicalize \
          --cse \
          --convert-nv-gpu-to-llvm \
          --convert-index-to-llvm \
          --convert-arith-to-llvm \
          --convert-math-to-llvm \
          --convert-cf-to-llvm \
          --reconcile-unrealized-casts \
          --canonicalize \
          --cse \
          -o "$kernel_llvm_mlir"
      fi
      test -s "$kernel_llvm_mlir" || die "kernel LLVM MLIR was not generated for $kernel_name"
      if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
        lower_ttg_warp_id_to_nvvm "$kernel_llvm_mlir"
      fi
      validate_no_triton_gpu_ops "$kernel_llvm_mlir"
      validate_no_unrealized_casts "$kernel_llvm_mlir"
    done
    maybe_stop llvm-mlir

    log "  [7/10] Translate kernels to LLVM IR"
    for ((ki = 0; ki < count; ++ki)); do
      if [[ "$(manifest_get "$manifest" "$ki" backend)" == "cuda-tile" ]]; then continue; fi
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_llvm_mlir="$(manifest_get "$manifest" "$ki" llvm_mlir)"
      kernel_ll="$(manifest_get "$manifest" "$ki" ll)"
      run "$MLIR_TRANSLATE" --mlir-to-llvmir "$kernel_llvm_mlir" -o "$kernel_ll"
      test -s "$kernel_ll" || die "kernel LLVM IR was not generated for $kernel_name"
    done
    maybe_stop llvm-ir

    if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
      log "  [8/10] Compile kernels to PTX"
    else
      log "  [8/10] Compile kernels to HSACO"
    fi
    for ((ki = 0; ki < count; ++ki)); do
      if [[ "$(manifest_get "$manifest" "$ki" backend)" == "cuda-tile" ]]; then continue; fi
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_ll="$(manifest_get "$manifest" "$ki" ll)"
      kernel_ptx="$(manifest_get "$manifest" "$ki" ptx)"
      kernel_object="$(manifest_get "$manifest" "$ki" object)"
      kernel_hsaco="$(manifest_get "$manifest" "$ki" hsaco)"
      kernel_codegen_ir="$kernel_ll"
      if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
        kernel_linked_bc="$kernel_ll.libdevice-linked.bc"
        kernel_optimized_bc="$kernel_ll.libdevice-opt.bc"
        if link_cuda_libdevice_if_needed \
            "$kernel_ll" "$kernel_linked_bc" "$kernel_optimized_bc" \
            "$kernel_name"; then
          kernel_codegen_ir="$kernel_optimized_bc"
        fi
        run "$LLC" -march=nvptx64 "-mcpu=sm_$SM" \
          "$kernel_codegen_ir" -o "$kernel_ptx"
        test -s "$kernel_ptx" || die "PTX was not generated for $kernel_name"
        validate_no_unresolved_cuda_libdevice_functions "$kernel_ptx" "$kernel_name"
      else
        kernel_linked_bc="$kernel_ll.rocm-linked.bc"
        kernel_optimized_bc="$kernel_ll.rocm-opt.bc"
        if link_rocm_device_libs_if_needed \
            "$kernel_ll" "$kernel_linked_bc" "$kernel_optimized_bc" \
            "$kernel_name"; then
          kernel_codegen_ir="$kernel_optimized_bc"
        fi
        run "$LLC" -mtriple=amdgcn-amd-amdhsa -march=amdgcn \
          "-mcpu=$GPU_ARCH" -filetype=obj "$kernel_codegen_ir" \
          -o "$kernel_object"
        test -s "$kernel_object" ||
          die "AMDGPU object was not generated for $kernel_name"
        run "$LD_LLD" -shared --no-undefined "$kernel_object" \
          -o "$kernel_hsaco"
        validate_hsaco "$kernel_hsaco" "$kernel_name"
      fi
    done
    if [[ "$ACCELERATOR_TARGET" == "cuda" ]]; then
      validate_ptx_kernel_abi "$manifest" "$json"
      maybe_stop ptx
    else
      maybe_stop hsaco
    fi
    maybe_stop device-image
  fi

  log "  [9/10] Embed kernel bundle"
  if [[ "$DRY_RUN" == "1" ]]; then
    quote_cmd python3 "<embed-bundle-helper>" "$manifest" "$json" "$embed_c"
    run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$embed_c" -o "$embed_obj"
  else
    generate_embedded_bundle_c "$manifest" "$json" "$embed_c"
    run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$embed_c" -o "$embed_obj"
    test -s "$embed_obj" || die "embedded object was not generated: $embed_obj"
  fi
  maybe_stop embed

  log "  [10/10] Generate host object"
  run "$TCO" "$host_fir" -o "$host_ll"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$host_ll" || die "host LLVM IR was not generated: $host_ll"
  fi
  maybe_stop host-ll

  run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$host_ll" -o "$host_obj"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$host_obj" || die "host object was not generated: $host_obj"
  fi
  maybe_stop host-obj

  # A relocatable link turns the host and bundle objects into one conventional
  # object.  It can be archived, copied, and linked later without sidecars.
  run "$CLANG" "${HOST_RELOCATE_FLAGS[@]}" -nostdlib -r \
    "$host_obj" "$embed_obj" -o "$output"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$output" || die "FNACC object was not generated: $output"
  fi
  maybe_stop object
}

declare -A COMPILE_OUTPUTS_SEEN=()
for index in "${!SOURCES[@]}"; do
  source="${SOURCES[$index]}"
  if [[ "$COMPILE_ONLY" == "1" ]]; then
    if [[ -n "$OUTPUT" ]]; then
      object="$OUTPUT"
    else
      object="$(sanitize_stem "$source").o"
    fi
    if [[ -n "${COMPILE_OUTPUTS_SEEN[$object]:-}" ]]; then
      die "multiple sources would write the same object: $object"
    fi
    COMPILE_OUTPUTS_SEEN["$object"]=1
  else
    object="$(object_for_src "$source")"
  fi
  SOURCE_OBJECTS[$index]="$object"

  if [[ "${SOURCE_IS_FNACC[$index]}" == "1" ]]; then
    compile_fnacc_source "$source" "$object"
  else
    compile_plain_source "$source" "$object"
  fi
done

maybe_stop objects

if [[ "$COMPILE_ONLY" == "1" ]]; then
  log "done"
  for object in "${SOURCE_OBJECTS[@]}"; do
    log "object: $object"
  done
  if [[ "$KEEP" == "1" ]]; then
    log "workdir kept: $WORKDIR"
  fi
  exit 0
fi

FINAL_LINK_ARGS=()
for item in "${LINK_SEQUENCE[@]}"; do
  if [[ "$item" =~ ^__FNACC_SOURCE_([0-9]+)__$ ]]; then
    index="${BASH_REMATCH[1]}"
    FINAL_LINK_ARGS+=("${SOURCE_OBJECTS[$index]}")
  else
    FINAL_LINK_ARGS+=("$item")
  fi
done

resolve_nm
NEEDS_FNACC_RUNTIME="$FORCE_RUNTIME"
if (( FNACC_SOURCE_COUNT > 0 )); then
  NEEDS_FNACC_RUNTIME=1
fi

for input in "${OTHER_INPUTS[@]}"; do
  if input_needs_fnacc_runtime "$input"; then
    NEEDS_FNACC_RUNTIME=1
  fi
done

RUNTIME_LINK_FLAGS=()
if [[ "$NEEDS_FNACC_RUNTIME" == "1" && "$DISABLE_RUNTIME" != "1" && "$RELOCATABLE_LINK" != "1" ]]; then
  [[ -n "${LLVM_BUILD:-}" ]] || die "LLVM_BUILD is required to link the FNACC runtime"
  case "${ACCELERATOR_TARGET,,}" in
    hip|amd|rocm)
      ACCELERATOR_TARGET=hip
      RUNTIME_LINK_FLAGS+=("-L$LLVM_BUILD/lib" -lFortranFNACCRuntimeHIP)
      if [[ -n "$HIP_LIB_DIR" ]]; then
        RUNTIME_LINK_FLAGS+=("-L$HIP_LIB_DIR" "-Wl,-rpath,$HIP_LIB_DIR")
      fi
      RUNTIME_LINK_FLAGS+=(-lamdhip64 -lstdc++ "-Wl,-rpath,$LLVM_BUILD/lib")
      ;;
    cuda|nvidia)
      ACCELERATOR_TARGET=cuda
      RUNTIME_LINK_FLAGS+=("-L$LLVM_BUILD/lib" -lFortranFNACCRuntime)
      if [[ -n "$CUDA_LIB_DIR" ]]; then
        RUNTIME_LINK_FLAGS+=("-L$CUDA_LIB_DIR" "-Wl,-rpath,$CUDA_LIB_DIR")
      fi
      RUNTIME_LINK_FLAGS+=(-lcuda -lstdc++ "-Wl,-rpath,$LLVM_BUILD/lib")
      ;;
    *) die "invalid FNACC target '$ACCELERATOR_TARGET'; expected cuda or hip" ;;
  esac
fi

[[ -n "$OUTPUT" ]] || OUTPUT="a.out"

log "link: ${#SOURCES[@]} source object(s), ${#OTHER_INPUTS[@]} other input(s) -> $OUTPUT"
if [[ "$NEEDS_FNACC_RUNTIME" == "1" ]]; then
  log "FNACC runtime: $([[ "$DISABLE_RUNTIME" == "1" || "$RELOCATABLE_LINK" == "1" ]] && echo deferred || echo enabled)"
fi

run "$FLANG" \
  "${FINAL_LINK_ARGS[@]}" \
  "${RUNTIME_LINK_FLAGS[@]}" \
  -o "$OUTPUT"

if [[ "$DRY_RUN" != "1" ]]; then
  test -f "$OUTPUT" || die "link output was not generated: $OUTPUT"
fi

maybe_stop link

log "done"
log "output: $OUTPUT"
if [[ "$KEEP" == "1" ]]; then
  log "workdir kept: $WORKDIR"
  if (( FNACC_SOURCE_COUNT > 0 )); then
    log "toolchain: $WORKDIR/toolchain.txt"
  fi
fi
